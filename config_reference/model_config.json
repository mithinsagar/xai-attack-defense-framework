{
  "_meta": {
    "author": "Mithin Sagar S",
    "github": "https://github.com/mithinsagar",
    "description": "Model hyperparameter configurations."
  },
  "logistic_regression": {
    "max_iter": 1000,
    "n_jobs": -1,
    "solver": "lbfgs",
    "C": 1.0
  },
  "xgboost": {
    "n_estimators": 100,
    "max_depth": 5,
    "learning_rate": 0.1,
    "subsample": 0.8,
    "colsample_bytree": 0.8,
    "eval_metric": "logloss",
    "random_state": 42,
    "n_jobs": -1
  },
  "mlp": {
    "hidden_layers": [256, 128, 64],
    "dropout": [0.3, 0.2, 0.0],
    "use_batchnorm": true,
    "output_dim": 1,
    "activation": "relu",
    "epochs_phishing": 20,
    "epochs_fraud": 20,
    "epochs_ids": 40,
    "batch_size_ids": 32,
    "learning_rate": 0.001,
    "learning_rate_ids": 0.0005
  }
}
